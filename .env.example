# ===========================================
# BK Work Schedule - Environment Variables
# ===========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ตรงกับระบบของคุณ
# Copy this file to .env and update the values

# Database Connection (PostgreSQL)
# รูปแบบ: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bkschedule

# Security
# SALT สำหรับ hash password (ใช้ค่าอะไรก็ได้ที่เป็นความลับ)
SALT=my-super-secret-salt-change-this

# Manager Registration
# รหัสยืนยันสำหรับสมัคร Manager (พนักงานต้องใส่รหัสนี้ถึงจะสมัคร Manager ได้)
MANAGER_VERIFY_CODE=BK2024

# Session
# อายุ session เป็นวินาที (86400 = 1 วัน, 604800 = 7 วัน)
SESSION_TTL_SECONDS=604800

# Branch Name
# ชื่อสาขาที่แสดงในแอป
BRANCH_NAME=Grand Diamond

# Resend Email (สำหรับ OTP)
# สมัครที่ https://resend.com เพื่อรับ API Key
# ถ้าไม่ต้องการใช้ OTP สามารถเว้นว่างได้
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Server Port
PORT=5000
