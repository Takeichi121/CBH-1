# ===========================================
# CBH — Chann Back House (Grand Diamond)
# Environment Variables
# ===========================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าให้ตรงกับระบบของคุณ
# Copy this file to .env and update the values

# -------------------------------------------
# ⚠️ จำเป็นต้องตั้งค่า (Required)
# -------------------------------------------

# Database Connection (PostgreSQL)
# รูปแบบ: postgresql://username:password@host:port/database
# สำหรับคอมร้าน (local): ใช้ localhost
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cbhdb

# Security — SALT สำหรับ hash password
# ใส่ค่าอะไรก็ได้ที่เป็นความลับ ห้ามเปลี่ยนหลังจากมีข้อมูลผู้ใช้แล้ว
SALT=my-super-secret-salt-change-this

# -------------------------------------------
# ✅ ตั้งค่าได้ (มีค่าเริ่มต้น)
# -------------------------------------------

# Manager Registration Code
# รหัสยืนยันสำหรับสมัคร Manager (ค่าเริ่มต้น: bk1040)
MANAGER_VERIFY_CODE=bk1040

# Area Manager Registration Code
# รหัสยืนยันสำหรับสมัคร Area Manager (ค่าเริ่มต้น: bkarea)
AREA_VERIFY_CODE=bkarea

# Session TTL (วินาที)
# อายุ session: 86400 = 1 วัน, 604800 = 7 วัน (ค่าเริ่มต้น: 21600 = 6 ชั่วโมง)
SESSION_TTL_SECONDS=604800

# Branch Name — ชื่อสาขาที่แสดงในแอป
BRANCH_NAME=Grand Diamond

# Server Port (ค่าเริ่มต้น: 5000)
PORT=5000

# -------------------------------------------
# 🤖 Chann AI (สำหรับฟีเจอร์ AI Assistant)
# -------------------------------------------
# บน Replit: ระบบตั้งค่าให้อัตโนมัติผ่าน Replit AI Integrations
# บนคอมร้าน: ต้องใส่ OpenAI API Key เอง
# สมัครที่ https://platform.openai.com/api-keys

# OpenAI (Replit AI Integration — ใช้บน Replit)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI (Direct — ใช้บนคอมร้านหรือนอก Replit)
# ใส่ค่าเดียวกับ AI_INTEGRATIONS_OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (ทางเลือกแทน OpenAI — ยังไม่ได้เปิดใช้งานในเวอร์ชันนี้)
# สมัครที่ https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google AI / Gemini (ทางเลือกแทน OpenAI — ยังไม่ได้เปิดใช้งานในเวอร์ชันนี้)
# สมัครที่ https://aistudio.google.com/
GOOGLE_AI_API_KEY=

# -------------------------------------------
# 📱 LINE Official Account
# -------------------------------------------
# การตั้งค่า LINE เก็บในฐานข้อมูล (ไม่ใช่ .env)
# ตั้งค่าได้ที่เมนู "การตั้งค่า" > "LINE OA" ในแอป
#
# หมายเหตุสำหรับ developer: LINE_TARGET_ID คือ userId หรือ groupId
# ที่ Chann จะส่งแจ้งเตือนหาผ่าน LINE Messaging API
LINE_TARGET_ID=

# -------------------------------------------
# 📧 Resend Email (สำหรับ OTP Reset Password)
# -------------------------------------------
# สมัครฟรีที่ https://resend.com (ส่งได้ 100 email/วัน)
# ถ้าไม่ใส่ = reset password ผ่าน email ไม่ได้ (ฟีเจอร์อื่นทำงานได้ปกติ)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# อีเมลผู้ส่ง — ต้องยืนยัน domain กับ Resend ก่อน
# ตัวอย่าง: noreply@yourdomain.com
RESEND_FROM_EMAIL=noreply@yourdomain.com
